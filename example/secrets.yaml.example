# Copy to secrets.yaml alongside production.yaml and fill in.
# secrets.yaml is gitignored -- keep it that way.
#
#   cp secrets.yaml.example secrets.yaml

# Your Wi-Fi SSID and password
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# Home Assistant API encryption key. Generate one with:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_key: "generate-a-32-byte-base64-key"

# Password for OTA updates. Set this before the first flash - changing it later
# means re-flashing over USB.
ota_password: "choose-an-ota-password"

# Password for the fallback access point the device brings up if it cannot join
# your Wi-Fi. Must be at least 8 characters.
fallback_password: "choose-a-fallback-password"
